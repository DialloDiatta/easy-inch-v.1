[sub_resource type="Resource" id="Resource_60fdj"]
script = ExtResource("4_l0be7")
title = "Getting Started"
instruction = "In this tutorial, you'll learn how to use our game interface.

Each Cell on the interface correlates with a number. 

Clicking on a cell activates it's value. Click on it again to deactivate it. You can see the interfaces active value to the right. "
video = ExtResource("5_60fdj")
metadata/_custom_type_script = "uid://msajlom3ov5w"

[sub_resource type="Resource" id="Resource_6baje"]
script = ExtResource("4_l0be7")
title = "Building Values"
instruction = "Each cell's value doubles as you go up the interface, starting at the bottom with 1 and ending at 16 at the top. 

Each cell type also has a name:
Yellow Fingers = 1
Green Double Finger = 2
Blue Palm = 4
Orange Double Palm = 8
Inch = 16

Tip: We encourage you use your own palms and fingers to help memorize the pieces. "
video = ExtResource("6_xtwk1")
metadata/_custom_type_script = "uid://msajlom3ov5w"

[sub_resource type="Resource" id="Resource_xtwk1"]
script = ExtResource("4_l0be7")
title = "Combining Cells"
instruction = "Multiple cells can be active at the same time. When two or more cells are active, their values combine with the sum shown on the right. "
video = ExtResource("7_s2rsc")
metadata/_custom_type_script = "uid://msajlom3ov5w"

[sub_resource type="Resource" id="Resource_s2rsc"]
script = ExtResource("4_l0be7")
title = "Practice"
instruction = "Before hopping onto the \"Time Trial\" game mode, practice counting forward and backwards from 0-16 using each row of cells. 

Tip: Say the value aloud as you count to make memorizing easier. 

When you're ready, hit the \"ESC' key to return to the main menu and select the \"Time Trial\" game mode."
video = ExtResource("8_c6vmu")
metadata/_custom_type_script = "uid://msajlom3ov5w"

