[sub_resource type="Resource" id="Resource_jwsg1"]
script = ExtResource("2_cakno")
title = "TIME TRIAL"
instruction = "Welcome to the TIME TRIAL!!

This is a fast paced game mode made to test your skills and help you improve!"
video = ExtResource("3_wxno1")
metadata/_custom_type_script = "uid://msajlom3ov5w"

[sub_resource type="Resource" id="Resource_ne57b"]
script = ExtResource("2_cakno")
title = "How To Play"
instruction = "Every round, a random number between your minimum and maximum values will appear on the right. 
Your goal is to place that value on the interface by activating it's cooresponding cells. 
You will see a flash of green when your answer is correct, then a new number will immediately be provided."
video = ExtResource("4_4gxn1")
metadata/_custom_type_script = "uid://msajlom3ov5w"

[sub_resource type="Resource" id="Resource_nu3vt"]
script = ExtResource("2_cakno")
title = "The Goal"
instruction = "Move fast! You will have a limited amount of time to place the correct value in the play space / interface. 

If your timer reaches 0 before you place the correct value, your run will end.

You will get less time the more answers you get correct. Stay sharp!

"
video = ExtResource("5_4gxn1")
metadata/_custom_type_script = "uid://msajlom3ov5w"

[sub_resource type="Resource" id="Resource_g01td"]
script = ExtResource("2_cakno")
title = "Scoring Points"
instruction = "You will get points for every puzzle you get correct.

Using fewer pieces and having more time left will give you more points!

Shoot to beat your personal high score!"
video = ExtResource("6_r06u8")
metadata/_custom_type_script = "uid://msajlom3ov5w"

[sub_resource type="Resource" id="Resource_wxno1"]
script = ExtResource("2_cakno")
title = "Difficulty"
instruction = "If large values are giving you some trouble, you can adjust your minimum and maximum sliders to make generated numbers smaller. 

Note: Feel free to pause the timer to enter practice mode. Your round will no longer end so you're free to play without pressure."
video = ExtResource("7_ljyjs")
metadata/_custom_type_script = "uid://msajlom3ov5w"

